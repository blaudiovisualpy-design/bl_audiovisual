generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  INACTIVE
}

enum InquiryStatus {
  NEW
  REVIEWING
  CONTACTED
  CLOSED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum MediaOrigin {
  LOCAL
  EXTERNAL
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(EDITOR)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  deletedBy    String?
  sessions     Session[]
  auditLogs    AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model Category {
  id        String        @id @default(cuid())
  slug      String        @unique
  nameEs    String
  nameEn    String
  sortOrder Int           @default(0)
  status    PublishStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  deletedBy String?
  projects  Project[]
}

model Project {
  id             String        @id @default(cuid())
  slug           String        @unique
  titleEs        String
  titleEn        String
  descriptionEs  String
  descriptionEn  String
  client         String
  year           Int
  videoProvider  String        @default("youtube")
  videoUrl       String
  posterUrl      String?
  posterAltEs    String?
  posterAltEn    String?
  featured       Boolean       @default(false)
  sortOrder      Int           @default(0)
  status         PublishStatus @default(PUBLISHED)
  categoryId     String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  deletedBy      String?
  category       Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
}

model Service {
  id            String        @id @default(cuid())
  titleEs       String
  titleEn       String
  descriptionEs String
  descriptionEn String
  icon          String?
  imageUrl      String?
  sortOrder     Int           @default(0)
  status        PublishStatus @default(PUBLISHED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  deletedBy     String?
}

model ProcessStep {
  id            String        @id @default(cuid())
  titleEs       String
  titleEn       String
  descriptionEs String
  descriptionEn String
  sortOrder     Int           @default(0)
  status        PublishStatus @default(PUBLISHED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  deletedBy     String?
}

model Client {
  id        String        @id @default(cuid())
  name      String
  logoUrl   String?
  website   String?
  sortOrder Int           @default(0)
  status    PublishStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  deletedBy String?
}

model Testimonial {
  id        String        @id @default(cuid())
  author    String
  role      String
  company   String
  quoteEs   String
  quoteEn   String
  photoUrl  String?
  sortOrder Int           @default(0)
  status    PublishStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  deletedBy String?
}

model ContactInquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  service   String
  message   String
  locale    String        @default("es")
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  deletedBy String?
}

model MediaAsset {
  id          String      @id @default(cuid())
  type        MediaType
  origin      MediaOrigin @default(LOCAL)
  url         String
  mimeType    String?
  sizeBytes   Int?
  altEs       String?
  altEn       String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  deletedBy   String?
}

model SiteSetting {
  id                 String   @id @default("site")
  siteName           String   @default("BL Audiovisual")
  heroEyebrowEs      String
  heroEyebrowEn      String
  heroTitle          String   @default("BL AUDIOVISUAL")
  heroTextEs         String
  heroTextEn         String
  aboutEs            String
  aboutEn            String
  email              String
  phone              String
  whatsapp           String
  instagram          String?
  youtube            String?
  locationEs         String
  locationEn         String
  logoUrl            String?
  heroPosterUrl      String?
  defaultLocale      String   @default("es")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
